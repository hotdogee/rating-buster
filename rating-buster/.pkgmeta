package-as: RatingBuster

# The addon lives in the rating-buster folder of the git repository, so the
# paths in this file are relative to the repository root. Package from the
# root with "release.sh -m rating-buster/.pkgmeta" (BigWigsMods/packager);
# move-folders then makes rating-buster the RatingBuster folder in the zip.

externals:
    rating-buster/libs/AceAddon-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceAddon-3.0
    rating-buster/libs/AceConfig-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceConfig-3.0
    rating-buster/libs/AceConsole-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceConsole-3.0
    rating-buster/libs/AceDB-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceDB-3.0
    rating-buster/libs/AceDBOptions-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceDBOptions-3.0
    rating-buster/libs/AceEvent-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceEvent-3.0
    rating-buster/libs/AceGUI-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceGUI-3.0
    rating-buster/libs/AceLocale-3.0: svn://svn.wowace.com/wow/ace3/mainline/trunk/AceLocale-3.0
    rating-buster/libs/CallbackHandler-1.0: svn://svn.wowace.com/wow/callbackhandler/mainline/trunk/CallbackHandler-1.0
    rating-buster/libs/LibBabble-Inventory-3.0: svn://svn.wowace.com/wow/libbabble-inventory-3-0/mainline/trunk
    rating-buster/libs/LibStub: svn://svn.wowace.com/wow/libstub/mainline/tags/1.0
    rating-buster/libs/LibStatLogic-1.2: svn://svn.wowace.com/wow/libstatlogic-1-2/mainline/trunk/LibStatLogic-1.2
    rating-buster/libs/LibTipHooker-1.1: svn://svn.wowace.com/wow/libtiphooker-1-1/mainline/trunk/LibTipHooker-1.1
    rating-buster/libs/LibDualSpec-1.0: git://git.wowace.com/wow/libdualspec-1-0/mainline.git
    rating-buster/libs/UTF8: svn://svn.wowace.com/wow/utf8/mainline/trunk

move-folders:
    RatingBuster/rating-buster: RatingBuster

optional-dependencies:
  - tank-points

ignore:
  - rating-buster/RatingBuster.wowproj
  - archive
  - image-tools
  - tests
  - Discription-Curse.txt
  - Discription-Curse-deDE.txt
  - Discription-PTT.txt
  - Discription-WoWInterface.txt
  - LICENSE
  - README.md
